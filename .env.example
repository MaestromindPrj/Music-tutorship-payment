# =========================================================================
# Music Tutorship - Environment Configuration
# Copy this file to .env.local and fill in your actual credentials
# =========================================================================

# 1. Neon PostgreSQL Database (Required for persistent storage & admin portal)
# Get this from https://console.neon.tech -> Project Dashboard -> Connection Details
DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. PayU Payment Gateway Credentials
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MERCHANT_MID=
PAYU_ENV=test
PAYU_IS_LIVE=false
PAYU_PAYMENT_URL=https://test.payu.in/_payment

# 4. Admin Authentication (Optional overrides; defaults exist in code)
ADMIN_EMAIL=admin@musictutorship.in
ADMIN_PASSWORD=Admin@MusicTutorship2025
ADMIN_SECRET=music-tutorship-admin-secret-jwt-key-2025



